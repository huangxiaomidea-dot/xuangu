# 复制本文件为 .env 并填写配置（.env 不会上传到 git）

# ── SMTP 邮件配置 ────────────────────────────────────────────
# 常见配置：
#   QQ邮筱：  SMTP_HOST=smtp.qq.com   SMTP_PORT=465
#   163邮筱： SMTP_HOST=smtp.163.com  SMTP_PORT=465
#   Gmail：   SMTP_HOST=smtp.gmail.com SMTP_PORT=465

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASS=your_smtp_authorization_code

MAIL_TO=huangxiao4@midea.com
