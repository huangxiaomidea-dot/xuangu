# 复制本文件为 .env 并填写配置（.env 不会上传到 git）

# ── SMTP 邮件配置 ────────────────────────────────────────
# 常见配置：
#   QQ邮箱：  SMTP_HOST=smtp.qq.com   SMTP_PORT=465  （授权码在 QQ邮箱设置→账户→SMTP服务）
#   163邮箱： SMTP_HOST=smtp.163.com  SMTP_PORT=465
#   Gmail：   SMTP_HOST=smtp.gmail.com SMTP_PORT=465
#   企业邮箱：联系IT获取 SMTP 服务器地址

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASS=your_smtp_authorization_code

# 收件人（已默认配置）
MAIL_TO=huangxiao4@midea.com
